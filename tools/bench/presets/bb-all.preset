# cricket with a broadband click on every pulse (24.1.1): 30 % of the tone's peak, above 6500 Hz. Needs output.broadband_* (this commit's image)
# The detection params are cricket's (release debounce 20, decisions/2026-11-17-sound-layer-may-set-detection-params.md); the broadband adds none.
PARAM SET output.hop_trill_pulses 10
PARAM SET output.hop_trill_gap_ms 15
PARAM SET output.hop_steps 5
PARAM SET output.hop_pulse_ms 15
PARAM SET output.hop_gap_ms 0
PARAM SET detection.scalar_release_debounce_ms 20
PARAM SET output.broadband_level 30
PARAM SET output.broadband_scope 0
PARAM SET output.broadband_low_hz 6500
PARAM SET output.trill_fade_ms 0
PARAM SET output.trill_droop_hz 0
PARAM SET output.trill_swell_pulses 0
