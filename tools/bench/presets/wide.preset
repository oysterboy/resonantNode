# the 2026-10-31 field: 950-4950 Hz, the defaults' pace
PARAM SET behavior.band_per_node 1
PARAM SET behavior.base_scatter_bins 1
PARAM SET output.silent 0
PARAM SET behavior.band_range_low_hz 950
PARAM SET behavior.band_range_high_hz 4950
PARAM SET behavior.chain_length 6
PARAM SET behavior.level_fall_ms 2000
PARAM SET behavior.answer_spread_ms 3000
PARAM SET output.idle_announce_hz 300
PARAM SET output.idle_announce_ms 500
